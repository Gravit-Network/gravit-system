FROM python:3.11-slim

WORKDIR /app

# Install dependencies
COPY services/consensus/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy source code
COPY services/consensus/ .
COPY sdk/python/ /app/sdk/

# Expose port
EXPOSE 8003

# Run the service
CMD ["uvicorn", "consensus_engine:app", "--host", "0.0.0.0", "--port", "8003"]
